<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>basic</artifactId>
        <groupId>com.basic</groupId>
        <version>4.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>basic-framework</artifactId>

    <description>
        framework框架核心（与 RuoYi-Vue 3.9.2 ruoyi-framework 对齐）
    </description>

    <dependencies>

        <!-- SpringBoot Web容器 (Spring Boot 4 改名为 webmvc) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- SpringBoot AOP (Spring Boot 4 改名为 aspectj) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- 阿里数据库连接池 (Spring Boot 4 专用) -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-4-starter</artifactId>
        </dependency>

        <!-- 验证码 -->
        <dependency>
            <groupId>pro.fessional</groupId>
            <artifactId>kaptcha</artifactId>
            <exclusions>
                <exclusion>
                    <artifactId>servlet-api</artifactId>
                    <groupId>javax.servlet</groupId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 获取系统信息 -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
        </dependency>

        <!-- 系统模块 -->
        <dependency>
            <groupId>com.basic</groupId>
            <artifactId>basic-admin-core</artifactId>
        </dependency>

        <!-- MyBatis-Plus 拦截器主类(MybatisPlusInterceptor / OptimisticLockerInnerInterceptor)
             在 extension jar 中 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>

        <!-- MyBatis-Plus 3.5.13+ 把 PaginationInnerInterceptor / BlockAttackInnerInterceptor 等
             移到 jsqlparser 子模块,且官方标为 <optional>true</optional>,不会随 starter 传递 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser-4.9</artifactId>
        </dependency>

        <!-- Jackson JSR310(Java 8 时间类型序列化/反序列化),
             Spring Boot 4.1.1 starter-json 不再默认传递 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

    </dependencies>

</project>
