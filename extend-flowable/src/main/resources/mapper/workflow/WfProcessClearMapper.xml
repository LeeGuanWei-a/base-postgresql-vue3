<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.basic.workflow.mapper.WfProcessClearMapper">

    <!--
      筛出真实存在的表。
      用 information_schema.tables + current_schemas(false)（即当前 search_path，
      不含隐式 pg_catalog）来判断，表名作为普通字符串参数传入，
      既不做动态拼 SQL，也避免了 ARRAY[$1,$2] 那种参数类型推断问题。
    -->
    <select id="selectExistingTables" resultType="java.lang.String">
        SELECT t.table_name
        FROM information_schema.tables t
        WHERE t.table_schema = ANY (current_schemas(false))
          AND t.table_name IN
        <foreach collection="tableNames" item="n" open="(" separator="," close=")">
            #{n}
        </foreach>
    </select>

    <!--
      清空单表。
      这里必须用 ${}（表名不能作为预编译参数）；
      tableName 由 Service 用白名单 + 正则 + 库内存在性三重校验后才传入。
    -->
    <delete id="deleteAllFromTable">
        DELETE FROM ${tableName}
    </delete>

    <!-- 统计单表行数（表名同样经三重校验后传入） -->
    <select id="countRows" resultType="int">
        SELECT COUNT(*) FROM ${tableName}
    </select>

</mapper>
