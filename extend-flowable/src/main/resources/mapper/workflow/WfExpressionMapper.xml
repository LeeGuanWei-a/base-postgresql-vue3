<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.basic.workflow.mapper.WfExpressionMapper">

    <resultMap type="WfExpression" id="WfExpressionResult">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="expression" column="expression"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectWfExpressionVo">
        select id, name, expression,type ,create_time, update_time, create_by, update_by, status, remark from flw_expression
    </sql>
    <!--        查询流程达式列表-->
    <select id="selectWfExpressionList" parameterType="WfExpression" resultMap="WfExpressionResult">
        <include refid="selectWfExpressionVo"/>
        <where>
            <if test="name != null  and name != ''">and name like '%' || #{name} || '%'</if>
            <if test="expression != null  and expression != ''">and expression = #{expression}</if>
            <if test="status != null ">and status = #{status}</if>
            <if test="type != null ">and type = #{type}</if>
        </where>
    </select>
    <!--    查询流程达式-->
    <select id="selectWfExpressionById" parameterType="Long" resultMap="WfExpressionResult">
        <include refid="selectWfExpressionVo"/>
        where id = #{id}
        order by create_time desc
    </select>
    <!--新增流程达式-->
    <insert id="insertWfExpression" parameterType="WfExpression" useGeneratedKeys="true" keyProperty="id">
        insert into flw_expression
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="expression != null">expression,</if>
            <if test="type!=null">type,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="expression != null">#{expression},</if>
            <if test="type !=null">#{type},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <!--    修改流程达式-->
    <update id="updateWfExpression" parameterType="WfExpression">
        update flw_expression
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="type!=null">type=#{type},</if>
            <if test="expression != null">expression = #{expression},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>
    <!--    删除流程达式-->
    <delete id="deleteWfExpressionById" parameterType="Long">
        delete from flw_expression where id = #{id}
    </delete>
    <!--    批量删除流程达式-->
    <delete id="deleteWfExpressionByIds" parameterType="String">
        delete from flw_expression where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
