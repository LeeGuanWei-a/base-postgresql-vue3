<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.basic.workflow.mapper.WfFormMapper">

    <resultMap type="com.basic.workflow.domain.WfForm" id="WfFormResult">
        <result property="formId" column="form_id"/>
        <result property="formName" column="form_name"/>
        <result property="status" column="status"/>
        <result property="code" column="code"/>
        <result property="content" column="content"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <!--    查询流程挂着的表单-->
    <select id="selectFormVoList" resultType="com.basic.workflow.domain.vo.WfFormVo">
        SELECT t1.form_id       AS formId,
               t2.activity_type AS activityType,
               t1.form_name     AS formName,
               t1.content       AS content
        FROM wf_form t1
                 LEFT JOIN wf_deploy_form t2 ON t1.form_id = t2.form_id
        where t2.deploy_id = #{deployId}
          and t2.activity_type = #{activityType}
    </select>
    <!--    查询自定义表单信息-->
    <select id="selectFormList" resultType="com.basic.workflow.domain.WfForm">
        select * from wf_form
        <where>
            del_flag ='0'
            <if test="codeList!=null">
                and code in
                <foreach collection="codeList" item="code" open="(" close=")" separator=",">
                    #{code}
                </foreach>
            </if>
        </where>
    </select>
    <select id="selectWfFormVoList" resultType="com.basic.workflow.domain.vo.WfFormVo">
        select * from wf_form
        <where>
            del_flag ='0'
            <if test="formName!=null and formName!=''">and form_name like '%' || #{formName} || '%'</if>
            <if test="code!=null and code!=''">and code =#{code}</if>
        </where>
        order by create_time desc
    </select>
</mapper>
