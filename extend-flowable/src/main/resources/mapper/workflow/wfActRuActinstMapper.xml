<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.basic.workflow.mapper.WfActRuActinstMapper">
    <!--    删除节点信息-->
    <delete id="deleteRunActinstsByIds" parameterType="java.util.List">
        delete from act_ru_actinst where ID_ in
        <foreach item="item" index="index" collection="list" open="(" separator="," close=")">
            #{item}
        </foreach>
    </delete>
    <!--    删除活动绑定的任务信息-->
    <delete id="deleteToRuActinstForTaskId">
        delete from act_ru_actinst where task_id_ = #{taskId}
    </delete>

</mapper>
