{
  "name": "基础平台",
  "appid": "__UNI__BASIC_MP",
  "description": "基础平台 - 移动端 (Vue3 + uview-plus + uniapp，纯 JS)",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
